# FoodBridge - Environment Variables
# Copy this file to .env and fill in your values

# ==========================================
# Backend Server
# ==========================================
PORT=5000
JWT_SECRET=your_super_secret_jwt_key_here_change_in_production

# ==========================================
# AI API Keys (Optional - enables LLM freshness estimation)
# ==========================================
GEMINI_API_KEY=
OPENAI_API_KEY=

# ==========================================
# Vercel Deployment (set automatically by Vercel)
# ==========================================
# VERCEL=1  ← set automatically by Vercel platform
